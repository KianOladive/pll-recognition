{
  "name": "pll-recognition",
  "private": true,
  "version": "1.0.0",
  "description": "Drill CFOP PLL recognition from two-sided cube pictures, with per-case timing and a weak-case focus mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs",
    "cubes": "node scripts/generate-cubes.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
